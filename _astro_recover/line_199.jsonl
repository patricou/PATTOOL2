{"role":"assistant","message":{"content":[{"type":"tool_use","name":"StrReplace","input":{"new_string":"            <div\n              class=\"ac-autodetect\"\n              *ngIf=\"!autoDetectModalOpen && (autoDetectLive || autoDetectBusy || autoDetectErrorKey || autoDetectHits.length)\"\n              id=\"acAutoDetectPanel\"\n              [class.ac-autodetect--live]=\"autoDetectLive\"\n              [attr.aria-live]=\"'polite'\">","old_string":"            <div\n              class=\"ac-autodetect\"\n              *ngIf=\"autoDetectLive || autoDetectBusy || autoDetectErrorKey || autoDetectHits.length\"\n              id=\"acAutoDetectPanel\"\n              [class.ac-autodetect--live]=\"autoDetectLive\"\n              [attr.aria-live]=\"'polite'\">","path":"c:\\Dev\\PATTOOL2\\PatTool_Front-End\\src\\app\\astro-compass\\astro-compass.component.html"}},{"type":"tool_use","name":"StrReplace","input":{"new_string":"</div>\n\n<!-- Auto-detect live immersive modal -->\n<div class=\"ac-live-backdrop\" *ngIf=\"autoDetectModalOpen\" (click)=\"closeAutoDetectModal()\" aria-hidden=\"true\"></div>\n<div\n  class=\"ac-live-modal\"\n  *ngIf=\"autoDetectModalOpen\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  [attr.aria-label]=\"'ASTRO_COMPASS.AUTO_MODAL_TITLE' | translate\"\n  (click)=\"$event.stopPropagation()\">\n  <div class=\"ac-live-modal__stars\" aria-hidden=\"true\"></div>\n  <div class=\"ac-live-modal__aurora\" aria-hidden=\"true\"></div>\n\n  <header class=\"ac-live-modal__header\">\n    <div class=\"ac-live-modal__header-main\">\n      <span class=\"ac-live-modal__live\">\n        <span class=\"ac-live-modal__live-dot\"></span>\n        {{ 'ASTRO_COMPASS.AUTO_LIVE_ON' | translate }}\n      </span>\n      <h3 class=\"ac-live-modal__title\">{{ 'ASTRO_COMPASS.AUTO_MODAL_TITLE' | translate }}</h3>\n    </div>\n    <button\n      type=\"button\"\n      class=\"ac-live-modal__close\"\n      (click)=\"closeAutoDetectModal()\"\n      [attr.aria-label]=\"'ASTRO_COMPASS.AUTO_CLEAR' | translate\">\n      <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n    </button>\n  </header>\n\n  <div class=\"ac-live-modal__controls\">\n    <label class=\"ac-live-switch\">\n      <input type=\"checkbox\" [(ngModel)]=\"autoDetectIncludePlanets\" (ngModelChange)=\"onAutoDetectFiltersChange()\" />\n      <span class=\"ac-live-switch__ui\"></span>\n      <span class=\"ac-live-switch__label\"><i class=\"fa fa-globe me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.AUTO_FILTER_PLANETS' | translate }}</span>\n    </label>\n    <label class=\"ac-live-switch\">\n      <input type=\"checkbox\" [(ngModel)]=\"autoDetectIncludeStars\" (ngModelChange)=\"onAutoDetectFiltersChange()\" />\n      <span class=\"ac-live-switch__ui\"></span>\n      <span class=\"ac-live-switch__label\"><i class=\"fa fa-star me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.AUTO_FILTER_STARS' | translate }}</span>\n    </label>\n    <label class=\"ac-live-switch\">\n      <input type=\"checkbox\" [(ngModel)]=\"autoDetectIncludeIss\" (ngModelChange)=\"onAutoDetectFiltersChange()\" />\n      <span class=\"ac-live-switch__ui\"></span>\n      <span class=\"ac-live-switch__label\"><i class=\"fa fa-space-shuttle me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.AUTO_FILTER_ISS' | translate }}</span>\n    </label>\n  </div>\n\n  <div class=\"ac-live-modal__rate\">\n    <div class=\"ac-live-modal__rate-head\">\n      <span>{{ 'ASTRO_COMPASS.AUTO_RATE' | translate }}</span>\n      <strong>{{ autoDetectIntervalMs }} ms</strong>\n    </div>\n    <input\n      class=\"ac-live-modal__slider\"\n      type=\"range\"\n      [min]=\"autoDetectIntervalMinMs\"\n      [max]=\"autoDetectIntervalMaxMs\"\n      [step]=\"autoDetectIntervalStepMs\"\n      [ngModel]=\"autoDetectIntervalMs\"\n      (ngModelChange)=\"onAutoDetectIntervalChange($event)\"\n      [attr.aria-label]=\"'ASTRO_COMPASS.AUTO_RATE' | translate\" />\n    <div class=\"ac-live-modal__rate-ends\">\n      <span>200 ms</span>\n      <span>3 s</span>\n    </div>\n  </div>\n\n  <div class=\"ac-live-modal__stage\" *ngIf=\"autoDetectBestHit as hit; else acLiveEmpty\">\n    <div class=\"ac-live-radar\" aria-hidden=\"true\">\n      <span class=\"ac-live-radar__ring ac-live-radar__ring--1\"></span>\n      <span class=\"ac-live-radar__ring ac-live-radar__ring--2\"></span>\n      <span class=\"ac-live-radar__ring ac-live-radar__ring--3\"></span>\n      <span class=\"ac-live-radar__cross-h\"></span>\n      <span class=\"ac-live-radar__cross-v\"></span>\n      <span class=\"ac-live-radar__center\" title=\"visées\"></span>\n      <span\n        class=\"ac-live-radar__target\"\n        [style.left.%]=\"autoDetectRadarXPercent()\"\n        [style.bottom.%]=\"autoDetectRadarYPercent()\"\n        [style.color]=\"hit.color\"\n        [style.boxShadow]=\"'0 0 18px ' + hit.color\">\n        <i [ngClass]=\"hit.iconClass\" aria-hidden=\"true\"></i>\n      </span>\n    </div>\n\n    <div class=\"ac-live-hero\">\n      <div class=\"ac-live-hero__orb\" [style.--ac-live-accent]=\"hit.color\">\n        <i [ngClass]=\"bodyIconClass || hit.iconClass\" aria-hidden=\"true\"></i>\n      </div>\n      <div class=\"ac-live-hero__meta\">\n        <span class=\"ac-live-hero__kind\">{{ autoDetectKindLabelKey(hit.kind) | translate }}</span>\n        <h2 class=\"ac-live-hero__name\">{{ bodyLabel || hit.name }}</h2>\n        <p class=\"ac-live-hero__sep\">\n          {{ 'ASTRO_COMPASS.AUTO_SEP' | translate : { deg: (hit.separationDeg | number : '1.0-1') } }}\n        </p>\n        <p class=\"ac-live-hero__aim\" *ngIf=\"autoDetectLookAz != null && autoDetectLookEl != null\">\n          {{ 'ASTRO_COMPASS.AUTO_AIM' | translate : {\n            az: (autoDetectLookAz | number : '1.0-0'),\n            el: (autoDetectLookEl | number : '1.0-0')\n          } }}\n        </p>\n      </div>\n    </div>\n\n    <div class=\"ac-live-info\">\n      <div class=\"ac-live-info__cell\" *ngIf=\"azimuthDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.AZIMUTH' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ azimuthDeg | number : '1.0-1' }}° · {{ cardinalLabel() }}</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"elevationDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.ELEVATION' | translate }}</span>\n        <span class=\"ac-live-info__v\" [class.ac-live-info__v--warn]=\"!aboveHorizon()\">{{ elevationDeg | number : '1.0-1' }}°</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"mag != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.MAGNITUDE' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ mag | number : '1.2-2' }}</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"constellationName\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.CONSTELLATION' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ constellationName }}</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"raHours != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.RA' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ raHours | number : '1.3-3' }} h</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"decDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.DEC' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ decDeg | number : '1.2-2' }}°</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"geoDistAu != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.GEO_DIST' | translate }}</span>\n        <span class=\"ac-live-info__v\">\n          {{ geoDistAu | number : '1.4-4' }} AU\n          <span *ngIf=\"geoDistKm != null\">· {{ geoDistKm | number : '1.0-0' }} km</span>\n        </span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"helioDistAu != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.HELIO_DIST' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ helioDistAu | number : '1.4-4' }} AU</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"phaseFraction != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.PHASE' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ phaseFraction * 100 | number : '1.0-0' }}%</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"elongationDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.ELONGATION' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ elongationDeg | number : '1.1-1' }}°</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"selectedKind === 'iss' && issAltKm != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.ISS_ALTITUDE' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ issAltKm | number : '1.0-0' }} km</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"selectedKind === 'iss' && issVelocityKmh != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.ISS_VELOCITY' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ issVelocityKmh | number : '1.0-0' }} km/h</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"selectedKind === 'iss' && issSlantKm != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.ISS_SLANT' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ issSlantKm | number : '1.0-0' }} km</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"riseAt\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.RISE' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ riseAt | date : 'HH:mm' }}</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"setAt\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.SET' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ setAt | date : 'HH:mm' }}</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"devicePitchDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.DEVICE_PITCH' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ devicePitchDeg | number : '1.0-1' }}°</span>\n      </div>\n      <div class=\"ac-live-info__cell\" *ngIf=\"headingDeg != null\">\n        <span class=\"ac-live-info__k\">{{ 'ASTRO_COMPASS.HEADING' | translate }}</span>\n        <span class=\"ac-live-info__v\">{{ headingDeg | number : '1.0-1' }}°</span>\n      </div>\n    </div>\n\n    <ul class=\"ac-live-others\" *ngIf=\"autoDetectHits.length > 1\">\n      <li class=\"ac-live-others__label\">{{ 'ASTRO_COMPASS.AUTO_OTHERS' | translate }}</li>\n      <li *ngFor=\"let other of autoDetectHits.slice(1)\">\n        <button type=\"button\" class=\"ac-live-others__btn\" (click)=\"applyAutoDetectHit(other)\">\n          <i [ngClass]=\"other.iconClass\" [style.color]=\"other.color\" aria-hidden=\"true\"></i>\n          <span>{{ other.name }}</span>\n          <em>{{ other.separationDeg | number : '1.0-1' }}°</em>\n        </button>\n      </li>\n    </ul>\n  </div>\n\n  <ng-template #acLiveEmpty>\n    <div class=\"ac-live-empty\">\n      <i class=\"fa fa-crosshairs\" aria-hidden=\"true\"></i>\n      <p *ngIf=\"autoDetectBusy\">{{ 'ASTRO_COMPASS.AUTO_SCANNING' | translate }}</p>\n      <p *ngIf=\"!autoDetectBusy && autoDetectErrorKey\">{{ autoDetectErrorKey | translate }}</p>\n      <p *ngIf=\"!autoDetectBusy && !autoDetectErrorKey\">{{ 'ASTRO_COMPASS.AUTO_NONE' | translate }}</p>\n    </div>\n  </ng-template>\n</div>\n\n<app-trace-viewer-modal\n  #traceViewerModalComponent\n  (locationSelected)=\"onLocationSelected($event)\">\n</app-trace-viewer-modal>","old_string":"</div>\n\n<app-trace-viewer-modal\n  #traceViewerModalComponent\n  (locationSelected)=\"onLocationSelected($event)\">\n</app-trace-viewer-modal>","path":"c:\\Dev\\PATTOOL2\\PatTool_Front-End\\src\\app\\astro-compass\\astro-compass.component.html"}}]}}
