{"role":"assistant","message":{"content":[{"type":"tool_use","name":"StrReplace","input":{"new_string":"            </div>\n\n            <div class=\"ac-compass-mid\" *ngIf=\"azimuthDeg != null\">\n              <div class=\"ac-compass-fresh\" *ngIf=\"updatedAgoLabel() as ago\">\n                <span class=\"ac-compass-fresh__dot\"></span>\n                <span class=\"ac-compass-fresh__txt\">{{ 'ASTRO_COMPASS.UPDATED' | translate }} {{ ago }}</span>\n              </div>\n\n              <ng-container *ngIf=\"relativeInstruction() as instr\">\n                <div class=\"ac-compass-turn\" [class.ac-compass-turn--facing]=\"instr.key === 'ASTRO_COMPASS.FACING'\">\n                  <ng-container *ngIf=\"instr.key === 'ASTRO_COMPASS.FACING'\">\n                    <i class=\"fa fa-check-circle me-2\" aria-hidden=\"true\"></i>{{ instr.key | translate }}\n                  </ng-container>\n                  <ng-container *ngIf=\"instr.key !== 'ASTRO_COMPASS.FACING'\">\n                    <i class=\"fa\" [class.fa-arrow-left]=\"instr.key === 'ASTRO_COMPASS.TURN_LEFT'\" [class.fa-arrow-right]=\"instr.key === 'ASTRO_COMPASS.TURN_RIGHT'\" aria-hidden=\"true\"></i>\n                    <span class=\"ms-2\">{{ instr.key | translate : { deg: instr.deg } }}</span>\n                  </ng-container>\n                </div>\n              </ng-container>\n            </div>\n\n            <div class=\"ac-look\" *ngIf=\"azimuthDeg != null\" [class.ac-look--below]=\"!aboveHorizon()\">\n              <div class=\"ac-look__title\">\n                <i class=\"fa fa-eye me-2\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_TITLE' | translate }}\n                <span *ngIf=\"bodyLabel\" class=\"ac-look__target\"> — {{ bodyLabel }}</span>\n              </div>\n              <div class=\"ac-look__grid\">\n                <div class=\"ac-look__tile ac-look__tile--dir\">\n                  <span class=\"ac-look__k\">\n                    <i class=\"fa fa-compass me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_DIRECTION' | translate }}\n                  </span>\n                  <span class=\"ac-look__cardinal\">{{ cardinalLabel() }}</span>\n                  <span class=\"ac-look__deg\">{{ azimuthDeg | number : '1.0-0' }}°</span>\n                  <span class=\"ac-look__hint\">{{ 'ASTRO_COMPASS.LOOK_DIRECTION_HINT' | translate : { cardinal: cardinalLabel(), deg: (azimuthDeg | number : '1.0-0') } }}</span>\n                </div>\n                <div class=\"ac-look__tile ac-look__tile--elev\" [class.ac-look__tile--warn]=\"!aboveHorizon()\">\n                  <span class=\"ac-look__k\">\n                    <i class=\"fa fa-arrows-v me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_ANGLE' | translate }}\n                  </span>\n                  <span class=\"ac-look__elev\">{{ elevationDeg | number : '1.0-0' }}°</span>\n                  <span class=\"ac-look__hint\" *ngIf=\"aboveHorizon() && (elevationDeg ?? 0) >= 2\">\n                    {{ 'ASTRO_COMPASS.LOOK_ANGLE_UP' | translate : { deg: (elevationDeg | number : '1.0-0') } }}\n                  </span>\n                  <span class=\"ac-look__hint\" *ngIf=\"aboveHorizon() && (elevationDeg ?? 0) < 2\">\n                    {{ 'ASTRO_COMPASS.LOOK_ANGLE_HORIZON' | translate }}\n                  </span>\n                  <span class=\"ac-look__hint ac-look__hint--warn\" *ngIf=\"!aboveHorizon()\">\n                    {{ 'ASTRO_COMPASS.LOOK_ANGLE_BELOW' | translate }}\n                  </span>\n                </div>\n              </div>\n              <ol class=\"ac-look__steps\">\n                <li>{{ 'ASTRO_COMPASS.LOOK_STEP1' | translate : { cardinal: cardinalLabel(), deg: (azimuthDeg | number : '1.0-0') } }}</li>\n                <li *ngIf=\"aboveHorizon()\">{{ 'ASTRO_COMPASS.LOOK_STEP2_UP' | translate : { deg: (elevationDeg | number : '1.0-0') } }}</li>\n                <li *ngIf=\"!aboveHorizon()\">{{ 'ASTRO_COMPASS.LOOK_STEP2_BELOW' | translate }}</li>\n              </ol>\n            </div>\n\n            <div class=\"ac-compass-hint ac-compass-hint--nosensor\" *ngIf=\"!headingActive\">","old_string":"            </div>\n\n            <div class=\"ac-look\" *ngIf=\"azimuthDeg != null\" [class.ac-look--below]=\"!aboveHorizon()\">\n              <div class=\"ac-look__title\">\n                <i class=\"fa fa-eye me-2\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_TITLE' | translate }}\n                <span *ngIf=\"bodyLabel\" class=\"ac-look__target\"> — {{ bodyLabel }}</span>\n              </div>\n              <div class=\"ac-look__grid\">\n                <div class=\"ac-look__tile ac-look__tile--dir\">\n                  <span class=\"ac-look__k\">\n                    <i class=\"fa fa-compass me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_DIRECTION' | translate }}\n                  </span>\n                  <span class=\"ac-look__cardinal\">{{ cardinalLabel() }}</span>\n                  <span class=\"ac-look__deg\">{{ azimuthDeg | number : '1.0-0' }}°</span>\n                  <span class=\"ac-look__hint\">{{ 'ASTRO_COMPASS.LOOK_DIRECTION_HINT' | translate : { cardinal: cardinalLabel(), deg: (azimuthDeg | number : '1.0-0') } }}</span>\n                </div>\n                <div class=\"ac-look__tile ac-look__tile--elev\" [class.ac-look__tile--warn]=\"!aboveHorizon()\">\n                  <span class=\"ac-look__k\">\n                    <i class=\"fa fa-arrows-v me-1\" aria-hidden=\"true\"></i>{{ 'ASTRO_COMPASS.LOOK_ANGLE' | translate }}\n                  </span>\n                  <span class=\"ac-look__elev\">{{ elevationDeg | number : '1.0-0' }}°</span>\n                  <span class=\"ac-look__hint\" *ngIf=\"aboveHorizon() && (elevationDeg ?? 0) >= 2\">\n                    {{ 'ASTRO_COMPASS.LOOK_ANGLE_UP' | translate : { deg: (elevationDeg | number : '1.0-0') } }}\n                  </span>\n                  <span class=\"ac-look__hint\" *ngIf=\"aboveHorizon() && (elevationDeg ?? 0) < 2\"